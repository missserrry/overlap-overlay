{
  "name": "svoy-overlay",
  "version": "0.2.1",
  "private": true,
  "description": "Overlap — личные оверлеи для iRacing: Relative, Standings, Weather, DigiFlag, Radar, Dash, Sectors",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node scripts/dev-server.js",
    "demo": "node scripts/dev-server.js --demo",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "local.overlap",
    "productName": "Overlap",
    "directories": { "output": "dist" },
    "files": [
      "src/**", "overlays/**", "package.json",
      "!design/**", "!reverse/**", "!scripts/**",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**"
    ],
    "asarUnpack": ["node_modules/koffi/**"],
    "win": { "target": ["nsis", "portable"], "icon": "overlays/common/brand/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overlap",
      "installerIcon": "overlays/common/brand/icon.ico",
      "uninstallerIcon": "overlays/common/brand/icon.ico",
      "artifactName": "Overlap-Setup-${version}.exe"
    },
    "portable": { "artifactName": "Overlap-${version}-portable.exe" }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "js-yaml": "^4.3.2",
    "koffi": "^2.16.3",
    "lucide-static": "^1.61.0",
    "seek-bzip": "^2.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "koffi@2.16.3": true,
    "electron@37.10.3": true
  }
}

{
  "name": "svoy-overlay",
  "version": "0.17.0",
  "private": true,
  "description": "Overlap — личные оверлеи для iRacing: Relative, Standings, Weather, DigiFlag, Radar, Dash, Sectors",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node scripts/dev-server.js",
    "demo": "node scripts/dev-server.js --demo",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "build": {
    "appId": "local.overlap",
    "productName": "Overlap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "overlays/**",
      "package.json",
      "!design/**",
      "!reverse/**",
      "!scripts/**",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/lucide-static/!(icons|package.json|LICENSE)",
      "!node_modules/lucide-static/!(icons|package.json|LICENSE)/**",
      "!node_modules/@fontsource/montserrat/files/!(montserrat-@(latin|latin-ext|cyrillic)-@(600|700)-normal.woff2)",
      "!node_modules/@fontsource-variable/inter/files/!(inter-@(latin|cyrillic)-wght-normal.woff2)",
      "!node_modules/@fontsource/jetbrains-mono/files/!(jetbrains-mono-@(latin|cyrillic)-400-normal.woff2)",
      "!node_modules/three/src/**",
      "!node_modules/three/examples/**",
      "!node_modules/three/build/!(three.module.js|three.core.js)"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@duckdb/**"
    ],
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "overlays/common/brand/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overlap",
      "installerIcon": "overlays/common/brand/icon.ico",
      "uninstallerIcon": "overlays/common/brand/icon.ico",
      "artifactName": "Overlap-Setup-${version}.exe",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "language": "1049",
      "menuCategory": false
    },
    "portable": {
      "artifactName": "Overlap-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "missserrry",
        "repo": "overlap-overlay"
      }
    ]
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "7z-wasm": "^1.2.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "js-yaml": "^4.3.2",
    "koffi": "^2.16.3",
    "lucide-static": "^1.61.0",
    "seek-bzip": "^2.0.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "koffi@2.16.3": true,
    "electron@37.10.3": true
  }
}
